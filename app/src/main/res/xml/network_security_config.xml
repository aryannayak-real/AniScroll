<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Some user-configured sources still serve plain HTTP, so cleartext stays
         permitted. User-installed CAs are no longer trusted in release builds:
         only preinstalled system CAs are accepted, which prevents third-party
         apps or malware from installing a CA and transparently MITM-ing traffic.
         Debug builds may still use user CAs to support local proxies. -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
